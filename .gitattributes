# Shell entry points must stay LF: a CRLF shebang makes macOS/Linux report
# "bad interpreter". Scoped to these patterns on purpose - a repo-wide
# "text=auto" would renormalize every existing file.
*.command text eol=lf
*.sh text eol=lf

# P1 evidence identities are byte-pinned and must survive Windows checkout.
ci/utiki-*.json text eol=lf
tests/fixtures/utiki/manifest.json text eol=lf
tests/fixtures/utiki/manifest-p2.json text eol=lf

# Production JS digests must match the bytes on Windows and macOS checkouts.
src/platforms/utiki/scripts/*.js text eol=lf
src/platforms/utiki/scripts/manifest.json text eol=lf
