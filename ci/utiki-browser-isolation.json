{
  "schema_version": 1,
  "contract_id": "utiki-browser-hard-egress-v1",
  "job_id": "browser-contract-isolated",
  "target": "isolated-linux-x64",
  "layer": [
    "browser-contract",
    "browser-isolation"
  ],
  "runtime": {
    "kind": "docker-linux-container",
    "image_must_be_digest_pinned": true,
    "accepted_image_references": [
      "repository-digest",
      "content-image-id"
    ],
    "build_evidence_required": true,
    "build_must_finish_before_isolation": true,
    "build_recipe_and_inputs_must_be_digested": true,
    "base_image_must_be_repository_digest": true,
    "image_pull_during_test": false,
    "network_mode": "none",
    "read_only_root": true,
    "cap_drop": [
      "ALL"
    ],
    "no_new_privileges": true,
    "privileged": false,
    "docker_socket_mount": false,
    "host_network": false,
    "host_pid": false,
    "repository_mount": "read-only",
    "artifact_mount": "write-only-purpose"
  },
  "canary": {
    "interception_state": "deliberately-not-installed",
    "controlled_peer_network": "internal-only",
    "positive_control_required": true,
    "required_probes": [
      "loopback-positive-control",
      "only-loopback-interface",
      "no-default-ipv4-route",
      "no-default-ipv6-route",
      "driver-direct-ipv4",
      "driver-direct-ipv6",
      "driver-dns",
      "driver-udp",
      "child-process-netns",
      "browser-subresource",
      "browser-redirect",
      "browser-websocket",
      "browser-worker"
    ],
    "forbidden_peer_paths": [
      "/driver-http",
      "/driver-ipv6",
      "/child-http",
      "/browser-subresource",
      "/browser-redirect",
      "/browser-redirect-target",
      "/browser-websocket",
      "/browser-worker"
    ],
    "forbidden_peer_events": [
      "PEER_EVENT udp kind=dns-query",
      "PEER_EVENT udp kind=quic"
    ]
  },
  "browser_command": [
    "python",
    "-m",
    "pytest",
    "-o",
    "addopts=",
    "--strict-config",
    "--strict-markers",
    "-m",
    "browser and not live",
    "tests/browser/utiki",
    "tests/test_ctbc_dom_fixtures.py"
  ],
  "production_origin": {
    "status_without_hard_isolation_report": "BLOCKED",
    "cdp_request_stage_interception_required": true,
    "unknown_request_action": "deny-and-fail",
    "classifier_or_allowlist_patch_forbidden": true,
    "host_resolver_or_proxy_is_not_hard_isolation": true,
    "production_connection_as_canary_forbidden": true,
    "live_authorization_implied": false
  },
  "native_platforms": {
    "windows-x64": "BLOCKED_UNTIL_EQUIVALENT_PROCESS_TREE_PROOF",
    "macos-arm64": "BLOCKED_UNTIL_EQUIVALENT_PROCESS_TREE_PROOF"
  }
}
