<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <title>uTiki server-assigned quantity fixture</title>
</head>
<body data-addcart-clicks="0" data-quantity-events="0">
  <!-- Synthetic/deidentified fixture captured from the 2026-10-15 contract. -->
  <form action="UTK0201_001/ADD_SHOPPING_CAR" method="post">
    <input id="PERFORMANCE_ID" value="P16D0B8Z" hidden>
    <input id="PRODUCT_ID" value="PRODUCT_FIXTURE" hidden>
    <input id="GROUP_ID" value="GROUP_FRONT" hidden>
    <input id="PERFORMANCE_PRICE_AREA_ID" value="PRICE_FRONT" hidden>
    <input id="QUANTITY_LIMIT" value="4" hidden>
    <table id="table_tickettype">
      <tbody>
        <tr>
          <td class="fill">全票</td>
          <td>
            <input id="AMOUNT" class="numbox" key="FULL" value="0">
            <input key="LAST_AMOUNT" value="5" hidden>
          </td>
        </tr>
        <tr>
          <td class="fill">其他票</td>
          <td>
            <input id="AMOUNT" class="numbox" key="OTHER" value="3">
            <input key="LAST_AMOUNT" value="5" hidden>
          </td>
        </tr>
      </tbody>
    </table>
    <input id="MASTER_CHK" value="WXYZ" hidden>
    <img id="chk_pic" alt="captcha">
    <button id="chang_pic" type="button">更換驗證碼</button>
    <input id="CHK" value="ABCD">
    <button id="addcart" type="button"
            onclick="document.body.dataset.addcartClicks = String(Number(document.body.dataset.addcartClicks || 0) + 1)">
      加入購物車
    </button>
  </form>
  <script>
    document.querySelectorAll('input.numbox[key]').forEach(input => {
      for (const eventName of ['input', 'change', 'blur']) {
        input.addEventListener(eventName, () => {
          document.body.dataset.quantityEvents = String(
            Number(document.body.dataset.quantityEvents || 0) + 1
          );
        });
      }
    });
  </script>
</body>
</html>
